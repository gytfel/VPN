# ── Telegram ──────────────────────────────────────────────────
BOT_TOKEN=                      # токен от @BotFather
ADMIN_IDS=                      # ваши telegram id через пробел, необязательно

# ── Панель Remnawave ──────────────────────────────────────────
REMNAWAVE_URL=http://remnawave:3000
REMNAWAVE_TOKEN=                # API-токен: панель → API Tokens
REMNAWAVE_SQUAD_UUID=           # UUID Internal Squad, куда класть покупателей

# ── Одноразовые ссылки ────────────────────────────────────────
PUBLIC_BASE=https://sub.example.com
LINK_PATH=get                   # ссылки вида https://sub.example.com/get/<token>
LINK_TTL_MINUTES=30

# ── Оплата (CryptoBot) ────────────────────────────────────────
CRYPTOBOT_TOKEN=                # токен из @CryptoBot → Crypto Pay → Create App
CRYPTOBOT_TESTNET=false

# ── Пробный период ────────────────────────────────────────────
TRIAL_ENABLED=true              # выдавать ли пробный доступ новым пользователям
TRIAL_DAYS=3
TRIAL_DEVICES=1                 # устройств на время пробного периода
TRIAL_TRAFFIC_GB=0              # 0 — без лимита трафика

# ── Служебное ─────────────────────────────────────────────────
DB_PATH=/data/bot.sqlite3
WEB_HOST=0.0.0.0
WEB_PORT=8080
TARIFFS_FILE=/app/tariffs.json
